{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "yarn": ">=1.22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node dist/index.cjs",
    "clean": "rm -rf dist",
    "aliases": "tsc-alias -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "build": "yarn build:theme && yarn build:types && yarn build:app && yarn build:server",
    "build:theme": "npx @chakra-ui/cli typegen ./src/theme/system.config.ts",
    "build:types": "tsc -b && tsc-alias -p tsconfig.json",
    "build:app": "vite build",
    "build:server": "tsup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@chakra-ui/react": "3.8.0",
    "@emotion/react": "11.14.0",
    "@fontsource/inter": "5.1.1",
    "@fontsource/noto-mono": "5.1.0",
    "@fontsource/nunito": "5.1.1",
    "@fontsource/pt-sans-narrow": "5.1.1",
    "@repo/logger": "*",
    "body-parser": "1.20.3",
    "cors": "2.8.5",
    "dayjs": "1.11.13",
    "express": "5.0.0",
    "morgan": "1.10.0",
    "next-themes": "0.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.4.0",
    "react-minimal-pie-chart": "9.1.0",
    "react-qr-code": "2.0.15",
    "react-timer-hook": "3.0.8",
    "react-use-measure": "2.1.7",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/compat": "1.2.6",
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.20.0",
    "@repo/eslint-config": "*",
    "@repo/jest-presets": "*",
    "@repo/typescript-config": "*",
    "@storybook/addon-essentials": "8.4.7",
    "@storybook/addon-themes": "8.4.7",
    "@storybook/react-vite": "8.4.7",
    "@types/body-parser": "1.19.5",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/morgan": "1.9.9",
    "@types/node": "22.13.4",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/parser": "8.24.0",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "eslint": "9.20.1",
    "eslint-import-resolver-typescript": "3.8.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-import-x": "4.6.1",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "eslint-plugin-storybook": "0.11.3",
    "globals": "15.15.0",
    "i18next": "24.2.2",
    "i18next-browser-languagedetector": "8.0.3",
    "i18next-http-backend": "3.0.2",
    "react-i18next": "15.2.0",
    "storybook": "8.4.7",
    "storybook-dark-mode": "4.0.2",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.10",
    "tslib": "2.8.1",
    "tsup": "8.3.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vite": "6.1.0",
    "vite-tsconfig-paths": "5.1.4"
  }
}
