{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "~22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "start": "node dist/index.cjs",
    "clean": "rm -rf dist && rm -rf .turbo",
    "aliases": "tsc-alias -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:theme && npm run build:types && npm run build:server && npm run build:app",
    "build:theme": "npx @chakra-ui/cli typegen ./src/theme/system.config.ts",
    "build:types": "tsc -b && tsc-alias -p tsconfig.json",
    "build:app": "vite build",
    "build:server": "tsup",
    "gcp-build": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@chakra-ui/react": "3.21.0",
    "@emotion/react": "11.14.0",
    "@fontsource/inter": "5.2.5",
    "@fontsource/noto-mono": "5.2.5",
    "@fontsource/nunito": "5.2.5",
    "@fontsource/pt-sans-narrow": "5.2.5",
    "@fontsource/the-girl-next-door": "5.2.5",
    "@repo/models": "*",
    "cors": "2.8.5",
    "date-fns": "4.1.0",
    "express": "5.1.0",
    "morgan": "1.10.0",
    "next-themes": "0.4.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-google-charts": "5.2.1",
    "react-icons": "^5.5.0",
    "react-minimal-pie-chart": "9.1.0",
    "react-qr-code": "2.0.15",
    "react-router": "7.6.1",
    "react-timer-hook": "3.0.8",
    "react-use-measure": "2.1.7",
    "zod": "3.25.46"
  },
  "devDependencies": {
    "@eslint/compat": "1.2.9",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.28.0",
    "@repo/eslint-config": "*",
    "@repo/jest-presets": "*",
    "@repo/typescript-config": "*",
    "@storybook/addon-essentials": "8.5.8",
    "@storybook/addon-themes": "8.5.8",
    "@storybook/react-vite": "8.5.8",
    "@storybook/test": "8.5.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.2",
    "@types/morgan": "1.9.9",
    "@types/node": "22.15.29",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@typescript-eslint/parser": "8.24.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "eslint": "9.28.0",
    "eslint-import-resolver-typescript": "3.8.3",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-import-x": "4.15.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "eslint-plugin-storybook": "0.11.3",
    "globals": "16.0.0",
    "i18next": "24.2.2",
    "i18next-browser-languagedetector": "8.0.4",
    "i18next-http-backend": "3.0.2",
    "react-i18next": "15.4.1",
    "storybook": "8.5.8",
    "storybook-dark-mode": "4.0.2",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.10",
    "tslib": "2.8.1",
    "tsup": "8.5.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.1",
    "vite": "6.3.5",
    "vite-plugin-dts": "4.5.4",
    "vite-tsconfig-paths": "5.1.4"
  }
}
