{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "~24"
  },
  "type": "module",
  "scripts": {
    "start": "node dist/index.cjs",
    "dev": "VERSION_NAME=dev tsup --watch --onSuccess \"node dist/index.cjs\"",
    "build": "tsup",
    "clean": "rm -rf dist && rm -rf .turbo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --detectOpenHandles --passWithNoTests"
  },
  "jest": {
    "preset": "@repo/jest-presets/node"
  },
  "dependencies": {
    "@google-cloud/datastore": "9.2.1",
    "@repo/models": "*",
    "cors": "2.8.5",
    "express": "5.1.0",
    "morgan": "1.10.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@repo/eslint-config": "*",
    "@repo/jest-presets": "*",
    "@repo/typescript-config": "*",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.2",
    "@types/morgan": "1.9.9",
    "@types/node": "24.10.9",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "typescript": "5.7.3"
  }
}
